#!url=https://raw.githubusercontent.com/tinphuc179-bot/locketgold/refs/heads/main/matintools-v2.sgmodule
#!name= [FullPentest]matintools.click
[Script]
revenuecat_bypass = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/tinphuc179-bot/locketgold_v2/refs/heads/main/matin_revenuecat.js, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/tinphuc179-bot/locketgold_v2/refs/heads/main/matin_deleteHeader.js, timeout=60
[MITM]
hostname = %APPEND% api.revenuecat.com
